
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum CarStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Car {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  brand        String
  model        String
  category     String?
  year         Int
  price        Decimal    @db.Decimal(12, 2)
  mileage      Int        @default(0)
  fuelType     String?
  transmission String?
  condition    String?
  description  String?
  status       CarStatus  @default(AVAILABLE)
  featured     Boolean    @default(false)
  isPublished  Boolean    @default(true)
  images       CarImage[]
  inquiries    Inquiry[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([brand])
  @@index([price])
  @@index([featured])
  @@index([isPublished])
}

model CarImage {
  id        String   @id @default(cuid())
  carId     String
  url       String
  publicId  String   @unique
  alt       String?
  sortOrder Int      @default(0)
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([carId, sortOrder])
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    InquiryStatus @default(NEW)
  carId     String?
  car       Car?          @relation(fields: [carId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
