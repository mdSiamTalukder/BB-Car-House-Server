NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
TRUST_PROXY=false

# Neon pooled connection string -> Neon console -> Connection Details.
# The string below is a PLACEHOLDER, never a real credential.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Generate a real one with: openssl rand -base64 48   (minimum 32 characters)
JWT_SECRET="PASTE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS_HERE"
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Seed values for `npm run prisma:seed` (creates the first admin account).
ADMIN_EMAIL=admin@example.com
ADMIN_NAME="BB Car House Admin"
ADMIN_PASSWORD="CHANGE_ME_BEFORE_SEEDING"

# Cloudinary is OPTIONAL. Leave these blank to run without it: the API, the
# Prisma seed and every non-upload route keep working. Requests that carry an
# image file then return HTTP 503 with code CLOUDINARY_NOT_CONFIGURED.
# Credentials: Cloudinary console -> Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bb-car-house

MAX_UPLOAD_SIZE_MB=5
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/avif